LOCAL_DOMAIN={{ mastodon_domain | default('boy.s.cz') }}
SINGLE_USER_MODE=false
{% if not mastodon_enable_ssl | default(false) %}
RAILS_FORCE_SSL=false
{% endif %}
SECRET_KEY_BASE={{ mastodon_secret_key_base }}
OTP_SECRET={{ mastodon_otp_secret }}
{% if mastodon_vapid_private_key | default('') | length > 0 %}
VAPID_PRIVATE_KEY={{ mastodon_vapid_private_key }}
VAPID_PUBLIC_KEY={{ mastodon_vapid_public_key }}
{% endif %}
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_NAME={{ mastodon_db_name | default('mastodon_production') }}
DB_USER=mastodon
DB_PASS={{ mastodon_db_password }}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SMTP_SERVER={{ mastodon_smtp_server | default('mail.studioiq.cz') }}
SMTP_PORT={{ mastodon_smtp_port | default('587') }}
SMTP_LOGIN={{ mastodon_smtp_login | default('f@simonformanek.cz') }}
SMTP_PASSWORD={{ mastodon_smtp_password | default('') }}
SMTP_AUTH_METHOD={{ mastodon_smtp_auth_method | default('plain') }}
SMTP_OPENSSL_VERIFY_MODE={{ mastodon_smtp_openssl_verify_mode | default('none') }}
SMTP_ENABLE_STARTTLS={{ mastodon_smtp_enable_starttls | default('auto') }}
SMTP_FROM_ADDRESS={{ mastodon_smtp_from_address | default('\'Mastodon <notifications@boy.s.cz>\'') }}

# Elasticsearch configuration for search functionality
{% if mastodon_enable_elasticsearch | default(true) %}
ES_ENABLED=true
ES_HOST=localhost
ES_PORT=9200
ES_PREFIX=mastodon_{{ mastodon_domain | regex_replace('\\.', '_') }}
{% else %}
ES_ENABLED=false
{% endif %}

# Active Record encryption keys
{% if deterministic_key is defined and deterministic_key|length > 0 %}
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY={{ deterministic_key[0] }}
{% endif %}
{% if key_derivation_salt is defined and key_derivation_salt|length > 0 %}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT={{ key_derivation_salt[0] }}
{% endif %}
{% if primary_key is defined and primary_key|length > 0 %}
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY={{ primary_key[0] }}
{% endif %}
